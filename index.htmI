<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Javad | My Website</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#080808;color:white;text-align:center;transition:.3s}
header{padding:20px;background:#111;border-bottom:1px solid #333;position:sticky;top:0}
nav a{color:white;text-decoration:none;margin:0 10px}
.hero{padding:85px 15px;background:radial-gradient(circle,#222,#080808 70%)}
h1{font-size:42px;margin-bottom:10px}.highlight{color:#00e5ff}
button{padding:12px 18px;margin:8px;border:0;border-radius:8px;cursor:pointer;background:#00e5ff;color:#111;font-weight:bold}
section{padding:35px 15px}
.card{display:inline-block;background:#161616;border:1px solid #333;border-radius:12px;padding:22px;margin:10px;width:220px}
input,textarea{width:90%;max-width:350px;padding:12px;margin:8px;border-radius:8px;border:1px solid #555}
footer{background:#111;padding:20px;color:#aaa}
.light{background:#f4f4f4;color:#111}.light header,.light footer{background:#ddd}.light .card{background:white;color:#111}
@media(max-width:600px){h1{font-size:30px}nav a{margin:0 4px;font-size:13px}.card{width:90%}}
</style>
</head>
<body>
<header><nav>
<a href="#home">Home</a><a href="#about">About</a><a href="#features">Features</a><a href="#contact">Contact</a>
</nav></header>
<div class="hero" id="home">
<h1>Welcome to <span class="highlight">Javad's Website</span></h1>
<p>My first website — built with code!</p>
<p>Local time: <strong id="clock">--:--:--</strong></p>
<button onclick="alert('Welcome to my website!')">Say Hello</button>
<button onclick="toggleTheme()">Change Theme</button>
</div>
<section id="about"><h2>About Me</h2><p>Hello! I'm Javad, and I'm learning web development.</p></section>
<section id="features"><h2>My Features</h2>
<div class="card"><h3>💻 Coding</h3><p>Learning how websites work.</p></div>
<div class="card"><h3>🎨 Design</h3><p>Creating cool web designs.</p></div>
<div class="card"><h3>🚀 Future</h3><p>Building bigger projects.</p></div><br>
<button onclick="changeColor()">Change Accent Color</button>
</section>
<section id="contact"><h2>Write a Message</h2>
<input id="name" placeholder="Your name"><br>
<textarea id="message" placeholder="Your message"></textarea><br>
<button onclick="sendMessage()">Show Message</button><p id="result"></p>
</section>
<footer><p>Made by Javad | My First Website</p></footer>
<script>
function toggleTheme(){document.body.classList.toggle("light")}
function changeColor(){
 const colors=["#00e5ff","#ff4d8d","#b388ff","#7CFC00","#ffb347"];
 const color=colors[Math.floor(Math.random()*colors.length)];
 document.querySelectorAll(".highlight").forEach(el=>el.style.color=color);
 document.querySelectorAll("button").forEach(el=>el.style.background=color);
}
function sendMessage(){
 const name=document.getElementById("name").value.trim();
 const message=document.getElementById("message").value.trim();
 document.getElementById("result").textContent=(!name||!message)?"Please enter your name and message.":name+" wrote: "+message;
}
function updateClock(){document.getElementById("clock").textContent=new Date().toLocaleTimeString()}
updateClock();setInterval(updateClock,1000);
</script>
</body>
</html>